__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/
.venv/

# Dépôt public : ni secrets, ni bases de données, ni sorties de run, ni état local des outils d'agent.
# (tests/test_repo_hygiene.py vérifie ce que git fait réellement de ces chemins)
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
runs/
# `.claude/settings.json` est versionné exprès (outils de planification soumis à approbation, docs/ops/taches-planifiees-agents.md).
.claude/*
!.claude/settings.json

# mutmut (tests de mutation, Linux/CI seulement)
mutants/
.mutmut-cache

# Fichiers générés localement par les outils (graphify, skills d'agents, captures de vérification)
graphify-out/
.agents/
skills-lock.json
design-system/**/*-screenshot*.png
